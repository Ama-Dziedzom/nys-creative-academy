# Copy to .env.local for local development, and add the same names in Vercel → Project → Settings → Environment Variables.

# Neon connection string (Neon dashboard → Connect). Leave unset locally to use the
# embedded database in .data/, which needs no setup.
DATABASE_URL=

# A long random value. Needed once, to create the first admin at /admin/setup.
# Generate one with: openssl rand -base64 32
ADMIN_SETUP_TOKEN=
