# Copy to .env.local for local development, and add the same names in Vercel → Project → Settings → Environment Variables.

# Neon connection strings. `neon env pull` writes both. Leave them unset locally to use
# the embedded database in .data/, which needs no setup.
# Pooled (-pooler) string, used by the app.
DATABASE_URL=
# Direct string, used by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=

# A long random value. Needed once, to create the first admin at /admin/setup.
# Generate one with: openssl rand -base64 32
ADMIN_SETUP_TOKEN=
